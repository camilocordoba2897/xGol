msgctxt "manual"
msgid "Página 24"
msgstr "Seite 24"

#: static/manual/manual-de-usuario.html:1589
msgctxt "manual"
msgid "Favorito, confianza, cuotas, goles y forma."
msgstr "Favorit, Vertrauen, Quoten, Tore und Form."

#: static/manual/manual-de-usuario.html:1589
msgctxt "manual"
msgid "Página 27"
msgstr "Seite 27"

#: static/manual/manual-de-usuario.html:1593
msgctxt "manual"
msgid "<b>¿Te perdiste?</b> Vuelve al índice o busca tu duda en las preguntas frecuentes."
msgstr "<b>Verlaufen?</b> Zurück zum Inhalt oder in den häufigen Fragen suchen."

#: static/manual/manual-de-usuario.html:1594
msgctxt "manual"
msgid "<b>Recuerda:</b> xGol informa, tú decides. Las probabilidades son estimaciones."
msgstr "<b>Merke:</b> xGol informiert, Sie entscheiden. Prognosen sind Schätzungen."

#: static/manual/manual-de-usuario.html:1597
msgctxt "manual"
msgid "Qué cambió en esta versión y cómo se preparó."
msgstr "Was sich in dieser Version geändert hat und wie sie entstand."

