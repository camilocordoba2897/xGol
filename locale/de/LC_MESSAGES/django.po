msgid "Página 8"
msgstr "Seite 8"

#: static/manual/manual-de-usuario.html:1585
msgctxt "manual"
msgid "Con usuario y contraseña, o con Google."
msgstr "Mit Benutzer und Passwort oder Google."

#: static/manual/manual-de-usuario.html:1585
msgctxt "manual"
msgid "Página 10"
msgstr "Seite 10"

#: static/manual/manual-de-usuario.html:1586
msgctxt "manual"
msgid "Mensual de 30 días o Trimestral de 90."
msgstr "Monatlich (30 Tage) oder Vierteljährlich (90)."

