msgctxt "manual"
msgid "Reglas actuales de la contraseña: 8 a 16 caracteres, mayúscula, minúscula, número y carácter especial."
msgstr "Aktuelle Passwortregeln: 8 bis 16 Zeichen, Groß- und Kleinbuchstabe, Zahl und Sonderzeichen."

#: static/manual/manual-de-usuario.html:1603
msgctxt "manual"
