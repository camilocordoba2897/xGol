msgid "Actívalo para finales o partidos en sede única: no se aplica ventaja local a ningún equipo."
msgstr "Turn it on for finals or single-venue matches: no home advantage is applied to either team."

#: static/js/vista.js:486
msgid "Cancha neutral"
msgstr "Neutral venue"
